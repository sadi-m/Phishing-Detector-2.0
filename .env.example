# Required: create with a password manager, at least 32 random characters.
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Set only for the first run when an administrator must be created. Remove afterwards.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=use_a_unique_password_with_12_or_more_characters

# Set to production behind HTTPS; cookies then require a secure connection.
# FLASK_ENV=production
